# OpenStreetMap Provider Configuration
# OpenFreeMap is configured as default (free, open-source vector tiles, 0 API keys required)
# Supported styles:
#   Night/Evening: https://tiles.openfreemap.org/styles/dark
#   Day:           https://tiles.openfreemap.org/styles/positron
VITE_OSM_PROVIDER=openfreemap

# Optional: If you ever want to switch to a proprietary key-based provider:
# MapTiler / Stadia Maps API key
VITE_OSM_API_KEY=
